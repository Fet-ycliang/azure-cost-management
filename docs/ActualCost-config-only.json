"{\n  \"version\": 2,\n  \"config\": {\n    \"sample_questions\": [\n      {\n        \"id\": \"01f145f79d981b74bcc9f6f1063fce1f\",\n        \"question\": [\n          \"上個月 Azure 平台各 MeterCategory 成本 TOP 10\"\n        ]\n      },\n      {\n        \"id\": \"01f145f79dc0147aace792e1b4e7f98e\",\n        \"question\": [\n          \"上個月 M365 平台各 ConsumedService 費用排名\"\n        ]\n      },\n      {\n        \"id\": \"01f145f79dd61ca3950cbff11f0f6631\",\n        \"question\": [\n          \"最近三個月各 PricingModel 每月費用趨勢\"\n        ]\n      },\n      {\n        \"id\": \"01f145f79df21b0489a4d7069417d93d\",\n        \"question\": [\n          \"上個月各 ResourceGroup 成本排名 TOP 10\"\n        ]\n      },\n      {\n        \"id\": \"01f145f79e0e1c2e92f30afe86528dbe\",\n        \"question\": [\n          \"上個月 Databricks 各產品類別費用分佈\"\n        ]\n      },\n      {\n        \"id\": \"01f145f79e2a10eabf0a270fa9f9f7e4\",\n        \"question\": [\n          \"兩個平台上個月費用總計各是多少\"\n        ]\n      },\n      {\n        \"id\": \"01f1460ae8ff107aae84cb49cdbb3f7e\",\n        \"question\": [\n          \"Azure 平台 2026年4月 Reservation 購買項目明細\"\n        ]\n      }\n    ]\n  },\n  \"data_sources\": {\n    \"tables\": [\n      {\n        \"identifier\": \"rag_develop_catalog.system_report.daily_azure_cost_usage_actual_view\",\n        \"column_configs\": [\n          {\n            \"column_name\": \"avg_effective_price\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"billing_origin_product\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"cluster_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"cost_center\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"datasource\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"env_type\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"meter\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"period\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"pricing_model\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"purpose\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"record_count\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"reservation\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"resource\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"resource_group_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"service_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"service_tier\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"total_cost\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"total_quantity\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"unit_of_measure\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"usg_date\",\n            \"enable_format_assistance\": true\n          }\n        ]\n      },\n      {\n        \"identifier\": \"system_catalog.system_report.daily_azure_cost_usage_actual_view\",\n        \"column_configs\": [\n          {\n            \"column_name\": \"avg_effective_price\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"billing_origin_product\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"cluster_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"cost_center\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"datasource\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"env_type\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"meter\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"period\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"pricing_model\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"purpose\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"record_count\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"reservation\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"resource\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"resource_group_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"service_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"service_tier\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"total_cost\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"total_quantity\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"unit_of_measure\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"usg_date\",\n            \"enable_format_assistance\": true\n          }\n        ]\n      }\n    ]\n  },\n  \"instructions\": {\n    \"text_instructions\": [\n      {\n        \"id\": \"01f1456099e311da815ebaf3c2e5999b\",\n        \"content\": [\n          \"## 跟使用者互動一律使用繁體中文\\n\",\n          \"\\n\",\n          \"## 實際成本 (Actual Cost) 定義與用途\\n\",\n          \"- Actual Cost = 實際成本，反映帳單上的實付金額，不含保留方案 (RI) 與節省方案 (Savings Plan) 的攤銷調整\\n\",\n          \"- 注意：Databricks 因有購買 Reservation，實際成本無法正確反映每日使用成本，如需估算每日 Databricks 費用請參考 AmortizedCost 空間\\n\",\n          \"- VM 與 Storage 同樣因購買保留方案，實際成本與估列成本會有落差，可搭配 AmortizedCost 空間交叉比對\\n\",\n          \"- 當使用者提到「實際」、「帳單」、「actual」時，均指本空間的實際成本資料\\n\",\n          \"- 當使用者要比較「實際成本 vs 估列成本」時，提醒他們估列成本資料在 AmortizedCost 空間，本空間僅含實際成本\\n\",\n          \"\\n\",\n          \"## 平台與 Catalog 對應\\n\",\n          \"- Azure 平台 = system_catalog，資料範圍 2024-10 至今\\n\",\n          \"- M365 平台 = rag_develop_catalog，資料範圍 2025-12 至今\\n\",\n          \"- 當使用者提到「Azure」、「Azure 平台」時，查詢 system_catalog 的表\\n\",\n          \"- 當使用者提到「M365」、「Microsoft 365」、「M365 平台」時，查詢 rag_develop_catalog 的表\\n\",\n          \"- 當使用者未指定平台時，預設查詢兩個平台合併的結果（UNION ALL）\\n\",\n          \"- 當使用者提到「全部」、「所有平台」、「跨平台」時，需 UNION ALL 兩個 catalog 的表\\n\",\n          \"\\n\",\n          \"## 欄位對應（view 已預先彙總）\\n\",\n          \"- 日期欄位：usg_date (DATE)\\n\",\n          \"- 成本欄位：total_cost (decimal) — 帳單幣別總成本\\n\",\n          \"- 用量欄位：total_quantity (decimal) — 總用量\\n\",\n          \"- 平均單價：avg_effective_price (decimal)\\n\",\n          \"- 筆數欄位：record_count (bigint) — 明細筆數\\n\",\n          \"- 月份欄位：period (DATE)，可用於按月篩選\\n\",\n          \"- 服務名稱：service_name（對應原 MeterCategory）\\n\",\n          \"- 服務層級：service_tier（對應原 MeterSubCategory）\\n\",\n          \"- 計費項目：meter（對應原 MeterName）\\n\",\n          \"- 計價模式：pricing_model（對應原 PricingModel）\\n\",\n          \"- 保留方案名稱：reservation（對應原 ReservationName）\\n\",\n          \"- 資源群組：resource_group_name（小寫）\\n\",\n          \"- 資源名稱：resource\\n\",\n          \"- 計量單位：unit_of_measure\\n\",\n          \"\\n\",\n          \"## 用途 = purpose 欄位\\n\",\n          \"- 使用者提到「用途」、「部門」或「專案」時，對應欄位為 purpose\\n\",\n          \"- Azure 平台常見值：digital, campaign, chnl_dw, mob_dw, abd, cdp, analyst, chatbot, ml 等\\n\",\n          \"- M365 平台常見值：ai_lab, ai_verse, fabric, ids-bot, operationai 等\\n\",\n          \"- purpose 為 NULL 表示未標記用途\\n\",\n          \"\\n\",\n          \"## env_type 環境類型（已小寫化）\\n\",\n          \"- view 中 env_type 已統一為小寫，直接篩選即可，不需 LOWER()\\n\",\n          \"- env_type LIKE 'prod%' = 正式環境\\n\",\n          \"- env_type LIKE 'dev%' = 開發環境\\n\",\n          \"\\n\",\n          \"## pricing_model 定價模式\\n\",\n          \"- OnDemand = 隨用隨付\\n\",\n          \"- Reservation = 保留方案 (RI)\\n\",\n          \"- SavingsPlan = 節省方案\\n\",\n          \"- Spot = Spot VM\\n\",\n          \"\\n\",\n          \"## 保留方案類型識別\\n\",\n          \"當使用者查詢保留方案相關費用時，透過 service_name 區分類型：\\n\",\n          \"- Virtual Machines = VM 保留方案（reservation 前綴 VM_RI_）\\n\",\n          \"- Storage = 儲存體保留方案（reservation 前綴 Blob_RI_）\\n\",\n          \"- Azure Synapse Analytics = Synapse 保留方案（reservation 前綴 SQLDW_RI_）\\n\",\n          \"- Azure Databricks = Databricks 保留方案（reservation 前綴 Databricks_Plan_）\\n\",\n          \"搭配 pricing_model = 'Reservation' 篩選即可取得所有保留方案明細。\\n\",\n          \"\\n\",\n          \"## 其他標籤欄位\\n\",\n          \"- billing_origin_product：計費來源產品（小寫）\\n\",\n          \"- cluster_name：叢集名稱\\n\",\n          \"- cost_center：成本中心\\n\",\n          \"\\n\",\n          \"## 幣別\\n\",\n          \"- 所有金額皆為 TWD（新台幣）\"\n        ]\n      }\n    ],\n    \"example_question_sqls\": [\n      {\n        \"id\": \"01f1456240f01a48923f0e9dcee1b21f\",\n        \"question\": [\n          \"每月各服務類別成本（Azure + M365 平台合併）\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  DATE_TRUNC('month', usg_date) AS month,\\n\",\n          \"  service_name,\\n\",\n          \"  ROUND(SUM(total_cost), 2) AS monthly_cost\\n\",\n          \"FROM (\\n\",\n          \"  SELECT usg_date, service_name, total_cost FROM system_catalog.system_report.daily_azure_cost_usage_actual_view\\n\",\n          \"  UNION ALL\\n\",\n          \"  SELECT usg_date, service_name, total_cost FROM rag_develop_catalog.system_report.daily_azure_cost_usage_actual_view\\n\",\n          \")\\n\",\n          \"GROUP BY DATE_TRUNC('month', usg_date), service_name\\n\",\n          \"ORDER BY month, monthly_cost DESC\"\n        ]\n      },\n      {\n        \"id\": \"01f1456240f01c38bd5b946743e1b78f\",\n        \"question\": [\n          \"各定價模式費用佔比（Azure + M365 平台合併）\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  DATE_TRUNC('month', usg_date) AS month,\\n\",\n          \"  pricing_model,\\n\",\n          \"  ROUND(SUM(total_cost), 2) AS monthly_cost,\\n\",\n          \"  ROUND(SUM(total_cost) * 100.0 / SUM(SUM(total_cost)) OVER (PARTITION BY DATE_TRUNC('month', usg_date)), 2) AS pct\\n\",\n          \"FROM (\\n\",\n          \"  SELECT usg_date, pricing_model, total_cost FROM system_catalog.system_report.daily_azure_cost_usage_actual_view\\n\",\n          \"  UNION ALL\\n\",\n          \"  SELECT usg_date, pricing_model, total_cost FROM rag_develop_catalog.system_report.daily_azure_cost_usage_actual_view\\n\",\n          \")\\n\",\n          \"GROUP BY DATE_TRUNC('month', usg_date), pricing_model\\n\",\n          \"ORDER BY month, monthly_cost DESC\"\n        ]\n      },\n      {\n        \"id\": \"01f1457c22391ed6b50c6fab86537e90\",\n        \"question\": [\n          \"(Azure平台) Virtual Machines 前一個月的費用\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  usg_date AS `日期`,\\n\",\n          \"  ROUND(SUM(CASE WHEN pricing_model != 'Reservation'\\n\",\n          \"                 THEN total_cost ELSE 0 END), 1) AS `總金額`\\n\",\n          \"FROM system_catalog.system_report.daily_azure_cost_usage_actual_view\\n\",\n          \"WHERE period = TRUNC(ADD_MONTHS(CURRENT_DATE, -1), 'month')\\n\",\n          \"  AND service_name = 'Virtual Machines'\\n\",\n          \"GROUP BY usg_date\\n\",\n          \"ORDER BY `日期`\"\n        ]\n      },\n      {\n        \"id\": \"01f145f74b2e14cf84b10c054b6cbd1c\",\n        \"question\": [\n          \"(Azure平台) Storage 前一個月的費用\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  usg_date AS `日期`,\\n\",\n          \"  ROUND(SUM(CASE WHEN pricing_model != 'Reservation'\\n\",\n          \"                 THEN total_cost ELSE 0 END), 1) AS `總金額`\\n\",\n          \"FROM system_catalog.system_report.daily_azure_cost_usage_actual_view\\n\",\n          \"WHERE period = TRUNC(ADD_MONTHS(CURRENT_DATE, -1), 'month')\\n\",\n          \"  AND service_name = 'Storage'\\n\",\n          \"GROUP BY usg_date\\n\",\n          \"ORDER BY `日期`\"\n        ]\n      },\n      {\n        \"id\": \"01f1460c5eab1b3a84c70959d85e649c\",\n        \"question\": [\n          \"(Azure平台) 保留方案 前一個月的明細\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  usg_date,\\n\",\n          \"  service_name,\\n\",\n          \"  ROUND(SUM(total_cost), 2) AS total_cost\\n\",\n          \"FROM system_catalog.system_report.daily_azure_cost_usage_actual_view\\n\",\n          \"WHERE period = TRUNC(ADD_MONTHS(CURRENT_DATE, -1), 'month')\\n\",\n          \"  AND pricing_model = 'Reservation'\\n\",\n          \"GROUP BY usg_date, service_name\\n\",\n          \"HAVING total_cost > 0\\n\",\n          \"ORDER BY usg_date, service_name\"\n        ]\n      },\n      {\n        \"id\": \"01f1461925d71e48a1bbdf28395ecadb\",\n        \"question\": [\n          \"(M365平台) Virtual Machines 前一個月的費用\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  usg_date AS `日期`,\\n\",\n          \"  ROUND(SUM(CASE WHEN pricing_model != 'Reservation'\\n\",\n          \"                 THEN total_cost ELSE 0 END), 1) AS `總金額`\\n\",\n          \"FROM rag_develop_catalog.system_report.daily_azure_cost_usage_actual_view\\n\",\n          \"WHERE period = TRUNC(ADD_MONTHS(CURRENT_DATE, -1), 'month')\\n\",\n          \"  AND service_name = 'Virtual Machines'\\n\",\n          \"GROUP BY usg_date\\n\",\n          \"ORDER BY `日期`\"\n        ]\n      },\n      {\n        \"id\": \"01f14619384e1d25a142a49ea6d05143\",\n        \"question\": [\n          \"(M365平台) Storage 前一個月的費用\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  usg_date AS `日期`,\\n\",\n          \"  ROUND(SUM(CASE WHEN pricing_model != 'Reservation'\\n\",\n          \"                 THEN total_cost ELSE 0 END), 1) AS `總金額`\\n\",\n          \"FROM rag_develop_catalog.system_report.daily_azure_cost_usage_actual_view\\n\",\n          \"WHERE period = TRUNC(ADD_MONTHS(CURRENT_DATE, -1), 'month')\\n\",\n          \"  AND service_name = 'Storage'\\n\",\n          \"GROUP BY usg_date\\n\",\n          \"ORDER BY `日期`\"\n        ]\n      }\n    ],\n    \"sql_snippets\": {\n      \"filters\": [\n        {\n          \"id\": \"01f1456240f719f9aec141822f2caa98\",\n          \"sql\": [\n            \"env_type LIKE 'prod%'\"\n          ],\n          \"display_name\": \"正式環境篩選 (Production)\"\n        },\n        {\n          \"id\": \"01f1456240f71ccb95aab7fd427e6a05\",\n          \"sql\": [\n            \"env_type LIKE 'dev%'\"\n          ],\n          \"display_name\": \"開發環境篩選 (Develop)\"\n        },\n        {\n          \"id\": \"01f1456240f71ede844b7a17e9481276\",\n          \"sql\": [\n            \"service_name = 'Azure Databricks'\"\n          ],\n          \"display_name\": \"Databricks 服務篩選\"\n        }\n      ],\n      \"measures\": [\n        {\n          \"id\": \"01f1456240f81223bf00d60f38d43ad5\",\n          \"sql\": [\n            \"SUM(total_cost)\"\n          ],\n          \"display_name\": \"總成本\"\n        }\n      ]\n    }\n  }\n}\n"