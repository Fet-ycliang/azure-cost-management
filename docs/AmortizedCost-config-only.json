"{\n  \"version\": 2,\n  \"config\": {\n    \"sample_questions\": [\n      {\n        \"id\": \"01f145f7d6ab1fb8897e7f7d6d2cdf3f\",\n        \"question\": [\n          \"上個月 Azure 平台各 MeterCategory 估列成本 TOP 10\"\n        ]\n      },\n      {\n        \"id\": \"01f145f7d6c21f47aee609bd650edf30\",\n        \"question\": [\n          \"上個月 M365 平台各 ConsumedService 估列費用排名\"\n        ]\n      },\n      {\n        \"id\": \"01f145f7d6d9133783b4810c2d67038c\",\n        \"question\": [\n          \"最近三個月各 PricingModel 每月估列費用趨勢\"\n        ]\n      },\n      {\n        \"id\": \"01f145f7d6ef1b048b4de869252ce6d3\",\n        \"question\": [\n          \"上個月各 ResourceGroup 估列成本排名 TOP 10\"\n        ]\n      },\n      {\n        \"id\": \"01f145f7d70c1709917b35087c591ead\",\n        \"question\": [\n          \"上個月 Databricks 各產品類別估列費用分佈\"\n        ]\n      },\n      {\n        \"id\": \"01f145f7d7211bf8b2b99e0fae627df0\",\n        \"question\": [\n          \"兩個平台上個月估列費用總計各是多少\"\n        ]\n      }\n    ]\n  },\n  \"data_sources\": {\n    \"tables\": [\n      {\n        \"identifier\": \"rag_develop_catalog.system_report.daily_azure_cost_usage_amortized_view\",\n        \"column_configs\": [\n          {\n            \"column_name\": \"avg_effective_price\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"billing_origin_product\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"cluster_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"cost_center\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"datasource\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"env_type\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"meter\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"period\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"pricing_model\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"purpose\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"record_count\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"reservation\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"resource\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"resource_group_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"service_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"service_tier\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"total_cost\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"total_quantity\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"unit_of_measure\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"usg_date\",\n            \"enable_format_assistance\": true\n          }\n        ]\n      },\n      {\n        \"identifier\": \"system_catalog.system_report.daily_azure_cost_usage_amortized_view\",\n        \"column_configs\": [\n          {\n            \"column_name\": \"avg_effective_price\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"billing_origin_product\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"cluster_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"cost_center\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"datasource\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"env_type\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"meter\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"period\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"pricing_model\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"purpose\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"record_count\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"reservation\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"resource\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"resource_group_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"service_name\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"service_tier\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"total_cost\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"total_quantity\",\n            \"enable_format_assistance\": true\n          },\n          {\n            \"column_name\": \"unit_of_measure\",\n            \"enable_format_assistance\": true,\n            \"enable_entity_matching\": true\n          },\n          {\n            \"column_name\": \"usg_date\",\n            \"enable_format_assistance\": true\n          }\n        ]\n      }\n    ]\n  },\n  \"instructions\": {\n    \"text_instructions\": [\n      {\n        \"id\": \"01f14564c2501fb09f9f067c52eccc0d\",\n        \"content\": [\n          \"## 跟使用者互動一律使用繁體中文\\n\",\n          \"\\n\",\n          \"## 估列成本 (Amortized Cost) 定義與用途\\n\",\n          \"- Amortized Cost = 估列成本／估列費用（也稱攤銷成本），會將保留方案 (RI) 與節省方案 (Savings Plan) 的前期費用攤銷至每日，反映資源的「應分攤成本」而非帳單上的實付金額\\n\",\n          \"- 主要用途：估算 Azure Databricks 費用——因 Databricks 有購買 Reservation，實際成本 (Actual Cost) 無法正確反映每日使用成本，必須參考估列費用來估算\\n\",\n          \"- VM 與 Storage 同樣因購買保留方案，實際成本與估列成本會有落差，可搭配 ActualCost 空間交叉比對差異\\n\",\n          \"- 當使用者提到「估列」、「攤銷」、「amortized」、「應分攤」時，均指本空間的估列成本資料\\n\",\n          \"- 當使用者要比較「實際成本 vs 估列成本」時，提醒他們實際成本資料在 ActualCost 空間，本空間僅含估列成本\\n\",\n          \"\\n\",\n          \"## 平台與 Catalog 對應\\n\",\n          \"- Azure 平台 = system_catalog，資料範圍 2024-10 至今\\n\",\n          \"- M365 平台 = rag_develop_catalog，資料範圍 2025-12 至今\\n\",\n          \"- 當使用者提到「Azure」、「Azure 平台」時，查詢 system_catalog 的表\\n\",\n          \"- 當使用者提到「M365」、「Microsoft 365」、「M365 平台」時，查詢 rag_develop_catalog 的表\\n\",\n          \"- 當使用者未指定平台時，預設查詢兩個平台合併的結果（UNION ALL）\\n\",\n          \"- 當使用者提到「全部」、「所有平台」、「跨平台」時，需 UNION ALL 兩個 catalog 的表\\n\",\n          \"\\n\",\n          \"## 欄位對應（view 已預先彙總）\\n\",\n          \"- 日期欄位：usg_date (DATE)\\n\",\n          \"- 成本欄位：total_cost (decimal) — 帳單幣別總成本\\n\",\n          \"- 用量欄位：total_quantity (decimal) — 總用量\\n\",\n          \"- 平均單價：avg_effective_price (decimal)\\n\",\n          \"- 筆數欄位：record_count (bigint) — 明細筆數\\n\",\n          \"- 月份欄位：period (DATE)，可用於按月篩選\\n\",\n          \"- 服務名稱：service_name（對應原 MeterCategory）\\n\",\n          \"- 服務層級：service_tier（對應原 MeterSubCategory）\\n\",\n          \"- 計費項目：meter（對應原 MeterName）\\n\",\n          \"- 計價模式：pricing_model（對應原 PricingModel）\\n\",\n          \"- 保留方案名稱：reservation（對應原 ReservationName）\\n\",\n          \"- 資源群組：resource_group_name（小寫）\\n\",\n          \"- 資源名稱：resource\\n\",\n          \"- 計量單位：unit_of_measure\\n\",\n          \"\\n\",\n          \"## 用途 = purpose 欄位\\n\",\n          \"- 使用者提到「用途」、「部門」或「專案」時，對應欄位為 purpose\\n\",\n          \"- Azure 平台常見值：digital, campaign, chnl_dw, mob_dw, abd, cdp, analyst, chatbot, ml 等\\n\",\n          \"- M365 平台常見值：ai_lab, ai_verse, fabric, ids-bot, operationai 等\\n\",\n          \"- purpose 為 NULL 表示未標記用途\\n\",\n          \"\\n\",\n          \"## env_type 環境類型（已小寫化）\\n\",\n          \"- view 中 env_type 已統一為小寫，直接篩選即可，不需 LOWER()\\n\",\n          \"- env_type LIKE 'prod%' = 正式環境\\n\",\n          \"- env_type LIKE 'dev%' = 開發環境\\n\",\n          \"\\n\",\n          \"## pricing_model 定價模式\\n\",\n          \"- OnDemand = 隨用隨付\\n\",\n          \"- Reservation = 保留方案 (RI)\\n\",\n          \"- SavingsPlan = 節省方案\\n\",\n          \"- Spot = Spot VM\\n\",\n          \"\\n\",\n          \"## 其他標籤欄位\\n\",\n          \"- billing_origin_product：計費來源產品（小寫）\\n\",\n          \"- cluster_name：叢集名稱\\n\",\n          \"- cost_center：成本中心\\n\",\n          \"\\n\",\n          \"## 幣別\\n\",\n          \"- 所有金額皆為 TWD（新台幣）\"\n        ]\n      }\n    ],\n    \"example_question_sqls\": [\n      {\n        \"id\": \"01f14564c2591ba8b017f60390c95c45\",\n        \"question\": [\n          \"各定價模式費用佔比（Azure + M365 平台合併）\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  DATE_TRUNC('month', usg_date) AS month,\\n\",\n          \"  pricing_model,\\n\",\n          \"  ROUND(SUM(total_cost), 2) AS monthly_cost,\\n\",\n          \"  ROUND(SUM(total_cost) * 100.0 / SUM(SUM(total_cost)) OVER (PARTITION BY DATE_TRUNC('month', usg_date)), 2) AS pct\\n\",\n          \"FROM (\\n\",\n          \"  SELECT usg_date, pricing_model, total_cost FROM system_catalog.system_report.daily_azure_cost_usage_amortized_view\\n\",\n          \"  UNION ALL\\n\",\n          \"  SELECT usg_date, pricing_model, total_cost FROM rag_develop_catalog.system_report.daily_azure_cost_usage_amortized_view\\n\",\n          \")\\n\",\n          \"GROUP BY DATE_TRUNC('month', usg_date), pricing_model\\n\",\n          \"ORDER BY month, monthly_cost DESC\"\n        ]\n      },\n      {\n        \"id\": \"01f1457c64761f02b58c303aca18c787\",\n        \"question\": [\n          \"(Azure平台) Azure Databricks 前一個月的費用\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  usg_date AS `日期`,\\n\",\n          \"  ROUND(SUM(total_cost), 1) AS `總金額`\\n\",\n          \"FROM system_catalog.system_report.daily_azure_cost_usage_amortized_view\\n\",\n          \"WHERE period = TRUNC(ADD_MONTHS(CURRENT_DATE, -1), 'month')\\n\",\n          \"  AND service_name = 'Azure Databricks'\\n\",\n          \"GROUP BY usg_date\\n\",\n          \"ORDER BY `日期`\"\n        ]\n      },\n      {\n        \"id\": \"01f14619754619b48cbe12b32434218b\",\n        \"question\": [\n          \"(M365平台) Azure Databricks 前一個月的費用\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  usg_date AS `日期`,\\n\",\n          \"  ROUND(SUM(total_cost), 1) AS `總金額`\\n\",\n          \"FROM rag_develop_catalog.system_report.daily_azure_cost_usage_amortized_view\\n\",\n          \"WHERE period = TRUNC(ADD_MONTHS(CURRENT_DATE, -1), 'month')\\n\",\n          \"  AND service_name = 'Azure Databricks'\\n\",\n          \"GROUP BY usg_date\\n\",\n          \"ORDER BY `日期`\"\n        ]\n      },\n      {\n        \"id\": \"01f146287d4e17eeb30928d278a44231\",\n        \"question\": [\n          \"(Azure平台) 服務名稱 前一個月的費用\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  service_name AS `服務名稱`,\\n\",\n          \"  ROUND(SUM(total_cost), 1) AS `總金額`\\n\",\n          \"FROM system_catalog.system_report.daily_azure_cost_usage_amortized_view\\n\",\n          \"WHERE period = TRUNC(ADD_MONTHS(CURRENT_DATE, -1), 'month')\\n\",\n          \"GROUP BY service_name\\n\",\n          \"HAVING ROUND(SUM(total_cost), 1) > 0\\n\",\n          \"ORDER BY `總金額` DESC\"\n        ]\n      },\n      {\n        \"id\": \"01f1462c5a2415cfa784fd20194ddaf3\",\n        \"question\": [\n          \"每月各服務類別成本（Azure + M365 平台合併）\"\n        ],\n        \"sql\": [\n          \"SELECT\\n\",\n          \"  DATE_TRUNC('month', usg_date) AS month,\\n\",\n          \"  service_name,\\n\",\n          \"  ROUND(SUM(total_cost), 2) AS monthly_cost\\n\",\n          \"FROM (\\n\",\n          \"  SELECT usg_date, service_name, total_cost FROM system_catalog.system_report.daily_azure_cost_usage_amortized_view\\n\",\n          \"  UNION ALL\\n\",\n          \"  SELECT usg_date, service_name, total_cost FROM rag_develop_catalog.system_report.daily_azure_cost_usage_amortized_view\\n\",\n          \")\\n\",\n          \"GROUP BY DATE_TRUNC('month', usg_date), service_name\\n\",\n          \"ORDER BY month, monthly_cost DESC\"\n        ]\n      }\n    ],\n    \"sql_snippets\": {\n      \"filters\": [\n        {\n          \"id\": \"01f14564c25b18cf93b6d8f617381886\",\n          \"sql\": [\n            \"env_type LIKE 'prod%'\"\n          ],\n          \"display_name\": \"正式環境篩選 (Production)\"\n        },\n        {\n          \"id\": \"01f14564c25d1599bfc141d4950a72a7\",\n          \"sql\": [\n            \"env_type LIKE 'dev%'\"\n          ],\n          \"display_name\": \"開發環境篩選 (Develop)\"\n        },\n        {\n          \"id\": \"01f14564c25f1430b03f204564abb840\",\n          \"sql\": [\n            \"service_name = 'Azure Databricks'\"\n          ],\n          \"display_name\": \"Databricks 服務篩選\"\n        }\n      ],\n      \"measures\": [\n        {\n          \"id\": \"01f14564c26219de9eb3528dbfeb34da\",\n          \"sql\": [\n            \"SUM(total_cost)\"\n          ],\n          \"display_name\": \"總成本\"\n        }\n      ]\n    }\n  }\n}\n"