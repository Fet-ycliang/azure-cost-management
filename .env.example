# MCP 服務對外設定
AZURE_COST_MCP_TRANSPORT=streamable-http
AZURE_COST_MCP_HOST=0.0.0.0
AZURE_COST_MCP_PORT=8000
AZURE_COST_MCP_STREAMABLE_HTTP_PATH=/mcp

# Azure 驗證模式
AZURE_COST_AUTH_MODE=azure-cli
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# Azure 管理平面 API
AZURE_MANAGEMENT_BASE_URL=https://management.azure.com
AZURE_COST_MANAGEMENT_API_VERSION=2025-03-01
AZURE_CONSUMPTION_API_VERSION=2024-08-01
AZURE_RESOURCE_GRAPH_API_VERSION=2024-04-01

# Azure Cost Management 查詢範圍
AZURE_COST_MANAGEMENT_SCOPE=/subscriptions/<subscription-id>
AZURE_COST_DEPARTMENT_TAG_KEY=Department

# M365 Cost Management 驗證範圍（目前主要供 operator-run 驗證流程使用）
M365_COST_MANAGEMENT_TENANT=
M365_COST_MANAGEMENT_SCOPE=/subscriptions/<m365-subscription-id>
M365_COST_DEPARTMENT_TAG_KEY=cost_center

# Azure Storage 成本資料落地層
AZURE_COST_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
AZURE_COST_STORAGE_CONTAINER=cost-data
AZURE_COST_STORAGE_PREFIX=cost-management

# 成本資料快取
AZURE_COST_CACHE_MODE=disk
AZURE_COST_CACHE_DIR=.cache\azure-cost-mcp
AZURE_COST_CACHE_TTL_SECONDS=900

# Databricks Genie MCP 連線設定
# 一般月度服務費用查詢預設走 AmortizedCost；ActualCost 主要留給 gate / reconciliation 驗證
DATABRICKS_MCP_BEARER_TOKEN=
DATABRICKS_MCP_TIMEOUT_SECONDS=60
# 建議明確分開設定兩個 Genie source
DATABRICKS_MCP_AMORTIZED_SERVER_URL=https://<amortizedcost-genie-mcp-server>
DATABRICKS_MCP_AMORTIZED_QUERY_TOOL_NAME=
DATABRICKS_MCP_ACTUAL_SERVER_URL=https://<actualcost-genie-mcp-server>
DATABRICKS_MCP_ACTUAL_QUERY_TOOL_NAME=
# 以下兩個為 legacy fallback；若未設定 source-specific 變數，會回退使用這組
DATABRICKS_MCP_SERVER_URL=https://<databricks-genie-mcp-server>
DATABRICKS_MCP_QUERY_TOOL_NAME=
# 以下兩個變數保留給未來的 tag 治理規劃，現階段不是必要設定
DATABRICKS_MCP_TAG_AUDIT_TOOL_NAME=
DATABRICKS_MCP_TAG_REMEDIATION_TOOL_NAME=

# tag 修正治理開關（保留給未來規劃）
AZURE_COST_TAG_APPLY_ENABLED=false

# Tag 盤點設定（Epic 1）
# 快取目錄（盤點結果的 JSON 及 Obsidian MD 的生成來源）
AZURE_COST_TAG_INVENTORY_CACHE_DIR=.cache/tag-inventory
# 必要 tag keys，多個以逗號分隔；M365 訂閱預設以 cost_center 為主
AZURE_COST_REQUIRED_TAG_KEYS=cost_center

# Lakebase 狀態儲存設定（Epic 4）
# 啟用後，tag_inventory 結果會自動 upsert 至 tag_snapshots，apply 結果寫入 tag_changes
LAKEBASE_ENABLED=false
# 靜態 URL（本地開發：含帳號密碼）
# LAKEBASE_PG_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>?ssl=require
# 動態 OAuth 模式（正式環境 Databricks Apps）
# LAKEBASE_INSTANCE_NAME=your-lakebase-instance
# LAKEBASE_DATABASE_NAME=azure_cost_mcp
# LAKEBASE_HOST=your-instance.database.us-east-1.cloud.databricks.com
LAKEBASE_SCHEMA_NAME=azure_cost_mcp

# Tag 批次回寫設定（Epic 3）
# 每批次最多同時更新的資源數量（預設 10）
AZURE_COST_TAG_APPLY_BATCH_SIZE=10
# 批次之間的等待毫秒數，避免觸發速率限制（預設 250）
AZURE_COST_TAG_APPLY_DELAY_MS=250
